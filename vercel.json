{
  "rewrites": [
    {
      "source": "/:path(.*\\.wasm$)",
      "destination": "/:path.gz"
    },
    {
      "source": "/assets/:path(.*\\.onnx$)",
      "destination": "/assets/:path.gz"
    },
    {
      "source": "/assets/component-CBjIO1XS.js",
      "destination": "/assets/component-CBjIO1XS.js.gz"
    },
    {
      "source": "/assets/index-CNcweh3o.js",
      "destination": "/assets/index-CNcweh3o.js.gz"
    },
    {
      "source": "/logo.png",
      "destination": "/logo.png.gz"
    }
  ],
  "headers": [
    {
      "source": "/(.*\\.wasm$)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/wasm"
        },
        {
          "key": "Content-Encoding",
          "value": "gzip"
        },
        {
          "key": "vary",
          "value": "Accept-Encoding"
        }
      ]
    },
    {
      "source": "/(.*\\.onnx$)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/octet-stream"
        },
        {
          "key": "Content-Encoding",
          "value": "gzip"
        },
        {
          "key": "vary",
          "value": "Accept-Encoding"
        }
      ]
    },
    {
      "source": "/assets/component-CBjIO1XS.js",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript"
        },
        {
          "key": "Content-Encoding",
          "value": "gzip"
        },
        {
          "key": "vary",
          "value": "Accept-Encoding"
        }
      ]
    },
    {
      "source": "/assets/index-CNcweh3o.js",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript"
        },
        {
          "key": "Content-Encoding",
          "value": "gzip"
        },
        {
          "key": "vary",
          "value": "Accept-Encoding"
        }
      ]
    },
    {
      "source": "/logo.png",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/png"
        },
        {
          "key": "Content-Encoding",
          "value": "gzip"
        },
        {
          "key": "vary",
          "value": "Accept-Encoding"
        }
      ]
    }
  ]
}